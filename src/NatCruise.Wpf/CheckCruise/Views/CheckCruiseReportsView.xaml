<UserControl x:Class="NatCruise.Wpf.CheckCruise.Views.CheckCruiseReportsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:NatCruise.Wpf.CheckCruise.Views"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:ctrls="clr-namespace:NatCruise.Wpf.Controls"
      xmlns:converters="clr-namespace:NatCruise.Wpf.Converters"
      xmlns:ccReports="clr-namespace:NatCruise.Wpf.CheckCruise.Reports"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      d:Background="{StaticResource MahApps.Brushes.Control.Background}">

    <Grid>
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>-->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!--<ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />-->
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Background="LightGray"
                mah:VisibilityHelper.IsVisible="{Binding ProcessedCheckCruisePath, Converter={StaticResource IsNullOrEmptyConverter}}"
                d:Visibility="Hidden">
            <TextBlock Text="Process Check Cruise First"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Column="0"
                  Grid.Row="0"
                  IsEnabled="{Binding ProcessedCheckCruisePath, Converter={StaticResource NotNullOrWhiteSpaceConverter}}"
                  d:IsEnabled="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>



                <StackPanel HorizontalAlignment="Left" Width="200" Margin="4" Orientation="Vertical">
                    <HeaderedContentControl Header="Check Cruiser Initials"
                                            Margin="4">
                        <ComboBox SelectedValue="{Binding CheckCruiserInitials}"
                                  ItemsSource="{Binding CheckCruiserInitialsOptions}" />
                    </HeaderedContentControl>

                    <Button Margin="5"
                            Content="Configure Tolerances" />

                </StackPanel>





            </Grid>

            <Grid Grid.Column="0"
                  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <HeaderedContentControl Header="Original Cruse to Compare"
                                            Width="200"
                                            Margin="4"
                                            HorizontalAlignment="Left">
                        <StackPanel>
                            <WrapPanel Orientation="Vertical">
                                <TextBox x:Name="_origCruisePathTextbox"
                                         Text="{Binding OrigCruisePath}"
                                         Width="200" />
                                <Button Content="Browse"
                                        Margin="0,2"
                                        Command="{Binding ShowBrowseOriginalCruiseDialogCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding AnalysisStatus}"
                                       mah:VisibilityHelper.IsVisible="{Binding AnalysisStatus, Converter={StaticResource IsVisableConverter}}"
                                       d:Text="Status..."
                                       Style="{StaticResource MahApps.Styles.TextBlock.Watermark}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <StackPanel Grid.Row="1">
                        <GroupBox Header="Options"
                                  Width="200">
                            <StackPanel Orientation="Vertical">
                                <StackPanel.Resources>
                                    <converters:IsValueConverter x:Key="isValueConverter" />
                                </StackPanel.Resources>
                                <RadioButton Content="By Sale"
                                             Margin="4"
                                             GroupName="_reportLevelRbGroup"
                                             IsChecked="{Binding ReportLevel, Converter={StaticResource isValueConverter}, ConverterParameter={x:Static ccReports:ReportLevel.BySale}}" />
                                <Border BorderThickness="1"
                                        BorderBrush="{StaticResource MahApps.Brushes.Control.Border}"
                                        CornerRadius="5"
                                        Padding="4">
                                    <StackPanel>

                                        <RadioButton x:Name="_byCruiserRb"
                                                     Content="By Cruiser"
                                                     GroupName="_reportLevelRbGroup"
                                                     IsChecked="{Binding ReportLevel, Converter={StaticResource isValueConverter}, ConverterParameter={x:Static ccReports:ReportLevel.ByCruiser}}" />
                                        <mah:MetroHeader Header="Cruiser Initials"
                                                         Margin="0,2">
                                            <ComboBox x:Name="_cruiserInitialsComboBox"
                                                      ItemsSource="{Binding CruiserInitialsOptions}"
                                                      SelectedValue="{Binding CruiserInitials}"
                                                      IsEnabled="{Binding IsChecked, ElementName=_byCruiserRb}" />
                                        </mah:MetroHeader>
                                        <mah:MetroHeader Header="Cruiser Name"
                                                         Margin="0,2">
                                            <TextBox x:Name="_cruiserNameTextBox"
                                                     Text="{Binding CruiserName}"
                                                     IsEnabled="{Binding IsChecked, ElementName=_byCruiserRb}" />
                                        </mah:MetroHeader>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="Generate Evaluation Report"
                                Command="{Binding GenerateEvaluationReportCommand}"
                                Margin="4"
                                HorizontalAlignment="Stretch" />
                        <Button Content="Generate Summary Report"
                                Command="{Binding GenerateSummaryReportCommand}"
                                Margin="4"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>


                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="4">



                </StackPanel>

            </Grid>
        </Grid>

    </Grid>
</UserControl>
